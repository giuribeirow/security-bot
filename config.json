{
  "brand": {
    "name": "Mineiro Security",
    "shortDescription": "Proteção inteligente para Discord com análise de mensagens, imagens, links e comportamento."
  },
  "defaults": {
    "enabled": true,
    "language": "pt-BR",
    "logChannelId": "",
    "adminRoleIds": [],
    "bypassRoleIds": [],
    "modules": {
      "messageAnalysis": true,
      "aiModeration": false,
      "imageAnalysis": true,
      "maliciousLinks": true,
      "raidProtection": true,
      "autoPunishment": true,
      "reports": true,
      "reputation": true
    },
    "sensitivity": 65,
    "actions": {
      "low": "log",
      "medium": "delete",
      "high": "timeout",
      "critical": "ban"
    },
    "timeouts": {
      "mediumMinutes": 10,
      "highMinutes": 60
    },
    "linkPolicy": {
      "blockedChannels": [],
      "allowedDomains": [],
      "blockInvites": true,
      "blockShorteners": true,
      "blockDownloads": true
    },
    "raid": {
      "joinWindowSeconds": 60,
      "joinThreshold": 8,
      "newAccountDays": 7,
      "autoLock": false
    },
    "image": {
      "detectQrCodes": true,
      "flagNewAccountsWithImages": true,
      "newAccountDays": 7
    },
    "ai": {
      "enabled": false,
      "mode": "assist",
      "minConfidence": 0.82,
      "maxTokens": 900
    }
  }
}
